# Disaster Response Telegram Bot - Environment Variables Template
# Copy this file to .env and fill in your actual values
# See SPEC.md Section 7.1.3 for details

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# User Account Configuration (for group chats and direct messages)
TELEGRAM_PHONE_NUMBER=
TELEGRAM_USER_SESSION=agent_aeris_user  # Session file name for user account

# LLM APIs
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini  # Default model (can be changed to gpt-4o, gpt-4-turbo, etc.)
GROK_API_KEY=your_grok_key
GROK_API_URL=https://api.x.com/v2/grok

# Chat API Authentication
LLM_API_KEY=your_secret_key  # API key for /api/llm/chat endpoint (Bearer token)

# Data Sources
OPENWEATHER_API_KEY=your_key
RELIEFWEB_API_KEY=your_key
NEWSAPI_KEY=your_key

# Session Management
REDIS_URL=your_redis_url  # Optional
SESSION_EXPIRY_HOURS=24

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# Admin Configuration
ADMIN_SECRET_KEY=your_secret_key
STREAMLIT_SERVER_PORT=8501

# Environment
ENVIRONMENT=development  # or production

