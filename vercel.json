{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/process-posts",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/process-agent",
      "schedule": "0 */6 * * *"
    }
  ]
}

